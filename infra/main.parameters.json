{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "botAppId": {
      "value": "${BOT_APP_ID}"
    },
    "botAppSecret": {
      "value": "${BOT_APP_SECRET}"
    },
    "botTenantId": {
      "value": "${BOT_TENANT_ID}"
    },
    "easyAuthAppId": {
      "value": "${EASYAUTH_APP_ID}"
    },
    "containerImage": {
      "value": "${SERVICE_OPENCLAW_IMAGE_NAME}"
    },
    "acaSandboxMode": {
      "value": "${ACA_SANDBOX_MODE=sandbox}"
    },
    "useExpressEnv": {
      "value": "${USE_EXPRESS_ENV=false}"
    },
    "skipStorage": {
      "value": "${SKIP_STORAGE=false}"
    },
    "openaiLocation": {
      "value": "${AZURE_OPENAI_LOCATION=}"
    },
    "squadName": {
      "value": "${SQUAD_NAME=core}"
    },
    "squadInstance": {
      "value": "${SQUAD_INSTANCE=1}"
    },
    "openclawMinReplicas": {
      "value": "${OPENCLAW_MIN_REPLICAS=1}"
    },
    "openclawMaxReplicas": {
      "value": "${OPENCLAW_MAX_REPLICAS=3}"
    }
  }
}
