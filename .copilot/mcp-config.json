{
  "mcpServers": {
    "squad_state": {
      "command": "npx",
      "args": [
        "-y",
        "@bradygaster/squad-cli@0.10.0",
        "state-mcp"
      ],
      "env": {},
      "tools": [
        "*"
      ]
    },
    "github": {
      "command": "node",
      "args": [
        "scripts/github-mcp-bridge.mjs"
      ],
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}",
        "GH_TOKEN": "${GH_TOKEN}"
      }
    }
  }
}
